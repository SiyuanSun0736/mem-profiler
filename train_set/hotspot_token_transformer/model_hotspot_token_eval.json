{
  "model": "HotspotWindowTokenPairTransformer",
  "config": "hotspot_token_base",
  "seed": 42,
  "pairs_path": "train_set/pairs.parquet",
  "run_features_path": "train_set/run_features.parquet",
  "output_dir": "train_set/hotspot_token_transformer",
  "architecture": "[summary+top6 hotspot_window tokens]x2->TransformerEncoder(3L,4H,ffn=256)->[summary_i;summary_j;summary_i-summary_j]->reg_head+cls_head",
  "source_isolation": {
    "baseline_script": "scripts/train_transformer.py",
    "experimental_script": "scripts/experimental/hotspot_token/train_hotspot_token_transformer.py",
